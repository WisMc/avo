{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AVO",
  "version": "1.0.0",
  "identifier": "com.avo.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../.. && npx serve -l 1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AVO",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
